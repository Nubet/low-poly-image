import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    width: 1000px;
    height: 700px;
    title: "Lowpoly";

    in-out property <string> input-path;
    in-out property <string> point-count: "500";
    in-out property <string> seed: "123";
    in-out property <bool> use-fixed-seed: false;
    in-out property <bool> is-processing: false;
    in property <bool> has-output: false;
    in-out property <string> preview-mode: "Low-poly result";
    in property <image> original-image;
    in property <string> status-text: "Ready";
    in property <image> output-image;

    callback generate();
    callback browse-input();
    callback save-output();

    HorizontalBox {
        padding: 24px;
        spacing: 24px;

        VerticalBox {
            width: 320px;
            spacing: 12px;

            Text {
                text: "Lowpoly generator";
                font-size: 26px;
            }

            Text {
                text: "Input image";
            }

            HorizontalBox {
                spacing: 8px;

                VerticalBox {
                    spacing: 6px;

                    Button {
                        text: "Choose image...";
                        enabled: !root.is-processing;
                        clicked => { root.browse-input(); }
                    }

                    Text {
                        text: root.input-path == "" ? "No image selected" : root.input-path;
                    }
                }
            }

            Text {
                text: "Points";
            }

            LineEdit {
                text <=> root.point-count;
                enabled: !root.is-processing;
            }

            Text {
                text: "Seed";
            }

            LineEdit {
                text <=> root.seed;
                enabled: root.use-fixed-seed && !root.is-processing;
            }

            CheckBox {
                text: "Use fixed seed";
                checked <=> root.use-fixed-seed;
                enabled: !root.is-processing;
            }

            Button {
                text: "Generate";
                enabled: !root.is-processing;
                clicked => { root.generate(); }
            }

            Button {
                text: "Save result...";
                enabled: root.has-output && !root.is-processing;
                clicked => { root.save-output(); }
            }

            ComboBox {
                model: ["Low-poly result", "Original"];
                current-value <=> root.preview-mode;
                enabled: root.has-output && !root.is-processing;
            }

            Text {
                text: root.status-text;
            }

            Rectangle { vertical-stretch: 1; }
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #20242b;

            if root.preview-mode == "Original": Image {
                source: root.original-image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if root.preview-mode == "Low-poly result": Image {
                source: root.output-image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
    }
}
